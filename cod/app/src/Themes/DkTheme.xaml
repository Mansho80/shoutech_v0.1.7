<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:sys="clr-namespace:System;assembly=mscorlib">
    <sys:String x:Key="ThemeName">Dark</sys:String>

    <!-- Core surfaces -->
    <SolidColorBrush x:Key="BackgroundBrush" Color="#1E1E1E"/>
    <SolidColorBrush x:Key="SurfaceBrush" Color="#2D2D2D"/>
    <SolidColorBrush x:Key="SurfaceLightBrush" Color="#3D3D3D"/>
    <SolidColorBrush x:Key="SurfaceDarkBrush" Color="#1A1A1A"/>
    <SolidColorBrush x:Key="SurfaceLighterBrush" Color="#4D4D4D"/>

    <!-- Shell (MWin) -->
    <SolidColorBrush x:Key="ShellBackgroundBrush" Color="#15171A"/>
    <SolidColorBrush x:Key="ShellMenuBackgroundBrush" Color="#20242B"/>
    <SolidColorBrush x:Key="ShellMenuForegroundBrush" Color="#FFFFFF"/>
    <SolidColorBrush x:Key="ShellToolbarBackgroundBrush" Color="#20242B"/>
    <SolidColorBrush x:Key="ShellRibbonBackgroundBrush" Color="#20242B"/>
    <SolidColorBrush x:Key="ShellRibbonForegroundBrush" Color="#FFFFFF"/>
    <SolidColorBrush x:Key="ShellRibbonBorderBrush" Color="#3E4654"/>
    <SolidColorBrush x:Key="ShellRibbonHoverBrush" Color="#2B313B"/>
    <SolidColorBrush x:Key="ShellContentBackgroundBrush" Color="#1B1F25"/>
    <SolidColorBrush x:Key="ShellContentBorderBrush" Color="#343B47"/>
    <SolidColorBrush x:Key="ShellStatusBarBackgroundBrush" Color="#0A5EA8"/>
    <SolidColorBrush x:Key="ShellStatusBarForegroundBrush" Color="#FFFFFF"/>

    <!-- Text -->
    <SolidColorBrush x:Key="TextBrush" Color="#FFFFFF"/>
    <SolidColorBrush x:Key="TextSecondaryBrush" Color="#C1C7D0"/>
    <SolidColorBrush x:Key="TextTertiaryBrush" Color="#97A0AE"/>
    <SolidColorBrush x:Key="TextDisabledBrush" Color="#666666"/>
    <SolidColorBrush x:Key="TextInverseBrush" Color="#1E1E1E"/>

    <!-- Borders -->
    <SolidColorBrush x:Key="BorderBrush" Color="#444444"/>
    <SolidColorBrush x:Key="BorderLightBrush" Color="#555555"/>
    <SolidColorBrush x:Key="BorderDarkBrush" Color="#333333"/>
    <SolidColorBrush x:Key="BorderAccentBrush" Color="#0078D4"/>

    <!-- Module workspace -->
    <SolidColorBrush x:Key="ModuleHeaderBackgroundBrush" Color="#0078D4"/>
    <SolidColorBrush x:Key="ModuleCardBackgroundBrush" Color="#2D2D2D"/>
    <SolidColorBrush x:Key="ModuleCardBorderBrush" Color="#3E3E42"/>
</ResourceDictionary>

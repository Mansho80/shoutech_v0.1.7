<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:sys="clr-namespace:System;assembly=mscorlib">
    <sys:String x:Key="ThemeName">Dark</sys:String>

    <!-- Core surfaces -->
    <SolidColorBrush x:Key="BackgroundBrush" Color="#202020"/>
    <SolidColorBrush x:Key="SurfaceBrush" Color="#202020"/>
    <SolidColorBrush x:Key="SurfaceLightBrush" Color="#2A2A2A"/>
    <SolidColorBrush x:Key="SurfaceDarkBrush" Color="#1A1A1A"/>
    <SolidColorBrush x:Key="SurfaceLighterBrush" Color="#303030"/>

    <!-- Shell (MainWindow) -->
    <SolidColorBrush x:Key="ShellBackgroundBrush" Color="#202020"/>
    <SolidColorBrush x:Key="ShellMenuBackgroundBrush" Color="#202020"/>
    <SolidColorBrush x:Key="ShellMenuForegroundBrush" Color="#FFFFFF"/>
    <SolidColorBrush x:Key="ShellToolbarBackgroundBrush" Color="#202020"/>
    <SolidColorBrush x:Key="ShellRibbonBackgroundBrush" Color="#202020"/>
    <SolidColorBrush x:Key="ShellRibbonForegroundBrush" Color="#FFFFFF"/>
    <SolidColorBrush x:Key="ShellRibbonBorderBrush" Color="#202020"/>
    <SolidColorBrush x:Key="ShellRibbonHoverBrush" Color="#2A2A2A"/>
    <SolidColorBrush x:Key="ShellContentBackgroundBrush" Color="#202020"/>
    <SolidColorBrush x:Key="ShellContentBorderBrush" Color="#202020"/>
    <SolidColorBrush x:Key="ShellStatusBarBackgroundBrush" Color="#202020"/>
    <SolidColorBrush x:Key="ShellStatusBarForegroundBrush" Color="#FFFFFF"/>

    <!-- Text -->
    <SolidColorBrush x:Key="TextBrush" Color="#FFFFFF"/>
    <SolidColorBrush x:Key="TextSecondaryBrush" Color="#C1C7D0"/>
    <SolidColorBrush x:Key="TextTertiaryBrush" Color="#97A0AE"/>
    <SolidColorBrush x:Key="TextDisabledBrush" Color="#6A6A6A"/>
    <SolidColorBrush x:Key="TextInverseBrush" Color="#202020"/>

    <!-- Borders -->
    <SolidColorBrush x:Key="BorderBrush" Color="#303030"/>
    <SolidColorBrush x:Key="BorderLightBrush" Color="#3A3A3A"/>
    <SolidColorBrush x:Key="BorderDarkBrush" Color="#2A2A2A"/>
    <SolidColorBrush x:Key="BorderAccentBrush" Color="#0078D4"/>

    <!-- Module workspace -->
    <SolidColorBrush x:Key="ModuleHeaderBackgroundBrush" Color="#0078D4"/>
    <SolidColorBrush x:Key="ModuleCardBackgroundBrush" Color="#202020"/>
    <SolidColorBrush x:Key="ModuleCardBorderBrush" Color="#2A2A2A"/>
</ResourceDictionary>

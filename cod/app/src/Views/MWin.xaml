<ribbon:RibbonWindow x:Class="ShouTech.App.Views.MWin"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:ribbon="clr-namespace:System.Windows.Controls.Ribbon;assembly=System.Windows.Controls.Ribbon"
        xmlns:shell="clr-namespace:System.Windows.Shell;assembly=PresentationFramework"
        Title="ShouTech"
        WindowStyle="None"
        ResizeMode="CanResize"
        shell:WindowChrome.WindowChrome="{StaticResource ShouTechWindowChrome}"
        Height="700"
        Width="1200"
        MinHeight="500"
        MinWidth="800"
        WindowStartupLocation="CenterScreen"
        WindowState="Maximized"
        FlowDirection="LeftToRight"
        UseLayoutRounding="True"
        SnapsToDevicePixels="True"
        FontFamily="Tahoma"
        FontSize="14"
        Background="{DynamicResource ShellBackgroundBrush}"
        Foreground="{DynamicResource TextBrush}">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="34"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- ShouTech custom window chrome: visually seamless with the page. -->
        <Grid x:Name="WindowChromeBar"
              Grid.Row="0"
              Height="34"
              Background="{DynamicResource ShellBackgroundBrush}"
              FlowDirection="LeftToRight"
              shell:WindowChrome.IsHitTestVisibleInChrome="True"
              MouseLeftButtonDown="OnTitleBarMouseLeftButtonDown">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>

            <!-- Intentionally blank: the shell uses a clean, title-less chrome area. -->
            <Border Grid.Column="0" Background="Transparent"/>

            <StackPanel Grid.Column="1"
                        Orientation="Horizontal"
                        VerticalAlignment="Stretch">
                <Button x:Name="MinimizeButton"
                        shell:WindowChrome.IsHitTestVisibleInChrome="True"
                        Style="{StaticResource WindowChromeButtonStyle}"
                        Content="─"
                        ToolTip="تصغير"
                        Click="OnMinimizeClick"/>
                <Button x:Name="MaximizeButton"
                        shell:WindowChrome.IsHitTestVisibleInChrome="True"
                        Style="{StaticResource WindowChromeButtonStyle}"
                        Content="□"
                        ToolTip="تكبير"
                        Click="OnMaximizeClick"/>
                <Button x:Name="CloseButton"
                        shell:WindowChrome.IsHitTestVisibleInChrome="True"
                        Style="{StaticResource WindowChromeCloseButtonStyle}"
                        Content="×"
                        ToolTip="إغلاق"
                        Click="OnCloseClick"/>
            </StackPanel>
        </Grid>

        <!-- شريط القوائم -->
        <Menu x:Name="MainMenu" Grid.Row="1"
              Background="{DynamicResource ShellMenuBackgroundBrush}"
              Foreground="{DynamicResource ShellMenuForegroundBrush}"
              Height="34"
              Padding="4,0"
              ClipToBounds="True">
            <Menu.Resources>
                <Style TargetType="{x:Type MenuItem}">
                    <Setter Property="FontFamily" Value="Tahoma"/>
                    <Setter Property="FontWeight" Value="SemiBold"/>
                    <Setter Property="FontSize" Value="14"/>
                    <Setter Property="Padding" Value="10,4"/>
                    <Setter Property="Margin" Value="1,0"/>
                    <Setter Property="Background" Value="Transparent"/>
                    <Setter Property="Foreground" Value="{DynamicResource ShellMenuForegroundBrush}"/>
                    <Setter Property="BorderThickness" Value="0"/>
                    <Style.Triggers>
                        <Trigger Property="IsHighlighted" Value="True">
                            <Setter Property="Background" Value="{DynamicResource ShellRibbonHoverBrush}"/>
                            <Setter Property="Foreground" Value="{DynamicResource TextBrush}"/>
                        </Trigger>
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter Property="Foreground" Value="{DynamicResource TextDisabledBrush}"/>
                        </Trigger>
                    </Style.Triggers>
                </Style>
            </Menu.Resources>
            <Menu.ItemsPanel>
                <ItemsPanelTemplate>
                    <StackPanel Orientation="Horizontal"/>
                </ItemsPanelTemplate>
            </Menu.ItemsPanel>
            <MenuItem x:Name="MenuFile" Header="ملف" Click="OnMenuFileClick"/>
            <MenuItem x:Name="MenuInventory" Header="مستودعات" Click="OnMenuInventoryClick"/>
            <MenuItem x:Name="MenuAccounts" Header="حسابات" Click="OnMenuAccountsClick"/>
            <MenuItem x:Name="MenuBonds" Header="سندات" Click="OnMenuBondsClick"/>
            <MenuItem x:Name="MenuInvoices" Header="فواتير" Click="OnMenuInvoicesClick"/>
            <MenuItem x:Name="MenuPOS" Header="نقاط بيع" Click="OnMenuPOSClick"/>
            <MenuItem x:Name="MenuOrders" Header="طلبيات" Click="OnMenuOrdersClick"/>
            <MenuItem x:Name="MenuCustomers" Header="عملاء" Click="OnMenuCustomersClick"/>
            <MenuItem x:Name="MenuSalesRep" Header="مندوب" Click="OnMenuSalesRepClick"/>
            <MenuItem x:Name="MenuManufacturing" Header="تصنيع" Click="OnMenuManufacturingClick"/>
            <MenuItem x:Name="MenuBanks" Header="بنوك" Click="OnMenuBanksClick"/>
            <MenuItem x:Name="MenuReports" Header="تقارير" Click="OnMenuReportsClick"/>
            <MenuItem x:Name="MenuTools" Header="أدوات" Click="OnMenuToolsClick"/>
            <MenuItem x:Name="MenuOtherTools" Header="أدوات أخرى" Click="OnMenuOtherToolsClick"/>
            <MenuItem x:Name="MenuView" Header="عرض" Click="OnMenuViewClick"/>
            <MenuItem x:Name="MenuExit" Header="خروج" Click="OnMenuExitClick"/>
            <MenuItem x:Name="MenuHelp" Header="مساعدة" Click="OnMenuHelpClick"/>
        </Menu>

        <!-- شريط الاختصارات -->
        <ToolBar x:Name="MainToolBar" Grid.Row="2" Background="{DynamicResource ShellToolbarBackgroundBrush}" Height="32" ToolBarTray.IsLocked="True">
            <ToolBar.Resources>
                <Style TargetType="Button">
                    <Setter Property="Background" Value="Transparent"/>
                    <Setter Property="Foreground" Value="{DynamicResource TextBrush}"/>
                    <Setter Property="BorderThickness" Value="0"/>
                    <Setter Property="Padding" Value="4"/>
                    <Setter Property="Margin" Value="1"/>
                    <Setter Property="Cursor" Value="Hand"/>
                    <Style.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter Property="Background" Value="{DynamicResource ShellRibbonHoverBrush}"/>
                        </Trigger>
                        <Trigger Property="IsPressed" Value="True">
                            <Setter Property="Background" Value="{DynamicResource BorderDarkBrush}"/>
                        </Trigger>
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter Property="Foreground" Value="{DynamicResource TextDisabledBrush}"/>
                        </Trigger>
                    </Style.Triggers>
                </Style>
            </ToolBar.Resources>
            <Button Content="💾" Margin="2" ToolTip="حفظ" Background="Transparent" Foreground="{DynamicResource TextBrush}" FontSize="16" Command="{Binding SaveCommand}"/>
            <Button Content="↩️" Margin="2" ToolTip="تراجع" Background="Transparent" Foreground="{DynamicResource TextBrush}" FontSize="16" Command="{Binding UndoCommand}"/>
            <Button Content="↪️" Margin="2" ToolTip="إعادة" Background="Transparent" Foreground="{DynamicResource TextBrush}" FontSize="16" Command="{Binding RedoCommand}"/>
            <Button Content="🖨️" Margin="2" ToolTip="طباعة" Background="Transparent" Foreground="{DynamicResource TextBrush}" FontSize="16" Command="{Binding PrintCommand}"/>
            <Button Content="🔍" Margin="2" ToolTip="بحث" Background="Transparent" Foreground="{DynamicResource TextBrush}" FontSize="16" Command="{Binding FindCommand}"/>
            <Button Content="⚙️" Margin="2" ToolTip="إعدادات" Background="Transparent" Foreground="{DynamicResource TextBrush}" FontSize="16" Command="{Binding SettingsCommand}"/>
            <Button Content="📊" Margin="2" ToolTip="تقارير" Background="Transparent" Foreground="{DynamicResource TextBrush}" FontSize="16" Command="{Binding ReportsCommand}"/>
            <Button Content="📥" Margin="2" ToolTip="استيراد" Background="Transparent" Foreground="{DynamicResource TextBrush}" FontSize="16" Command="{Binding ImportCommand}"/>
            <Button Content="📤" Margin="2" ToolTip="تصدير" Background="Transparent" Foreground="{DynamicResource TextBrush}" FontSize="16" Command="{Binding ExportCommand}"/>
            <Button Content="{Binding ThemeToggleIcon}"
                    Margin="2"
                    Width="32"
                    Height="28"
                    ToolTip="{Binding ThemeToggleTooltip}"
                    Background="Transparent"
                    Foreground="{DynamicResource TextBrush}"
                    FontFamily="Segoe UI Symbol"
                    FontSize="17"
                    Command="{Binding ToggleThemeCommand}"/>
            <Button Content="🚪" Margin="2" ToolTip="خروج" Background="Transparent" Foreground="{DynamicResource TextBrush}" FontSize="16" Command="{Binding ExitCommand}"/>
        </ToolBar>

        <!-- الـ Ribbon -->
        <ribbon:Ribbon Grid.Row="3" x:Name="RibbonControl"
                       Background="{DynamicResource ShellRibbonBackgroundBrush}"
                       Foreground="{DynamicResource ShellRibbonForegroundBrush}"
                       Visibility="Collapsed"
                       IsMinimized="False">
            
            <!-- ============================================================
                 تبويب: ملف
                 ============================================================ -->
            <ribbon:RibbonTab x:Name="TabFile" Header="ملف" Visibility="Collapsed">
                <ribbon:RibbonGroup Header="العمليات">
                    <ribbon:RibbonButton Label="جديد" Click="OnRibbonButtonClick"/>
                    <ribbon:RibbonButton x:Name="RibbonOpenCompanyButton" Label="فتح" Click="OnRibbonButtonClick"/>
                    <ribbon:RibbonButton Label="استيراد بيانات" Click="OnRibbonButtonClick"/>
                    <ribbon:RibbonButton Label="تصدير بيانات" Click="OnRibbonButtonClick"/>
                </ribbon:RibbonGroup>
                <ribbon:RibbonGroup Header="نقطة بيع">
                    <ribbon:RibbonButton Label="استيراد بيانات نقطة بيع" Click="OnRibbonButtonClick"/>
                    <ribbon:RibbonButton Label="تصدير بيانات نقطة بيع" Click="OnRibbonButtonClick"/>
                    <ribbon:RibbonButton Label="استيراد بطاقة" Click="OnRibbonButtonClick"/>
                </ribbon:RibbonGroup>
                <ribbon:RibbonGroup Header="خروج">
                    <ribbon:RibbonButton Label="خروج" Click="OnRibbonButtonClick"/>
                </ribbon:RibbonGroup>
            </ribbon:RibbonTab>

            <!-- ============================================================
                 تبويب: مستودعات
                 ============================================================ -->
            <ribbon:RibbonTab x:Name="TabInventory" Header="مستودعات" Visibility="Collapsed">
                <ribbon:RibbonGroup Header="البطاقات">
                    <ribbon:RibbonButton Label="بطاقة مادة" Click="OnRibbonButtonClick"/>
                    <ribbon:RibbonButton Label="بطاقة صنف" Click="OnRibbonButtonClick"/>
                    <ribbon:RibbonButton Label="بطاقة مستودع" Click="OnRibbonButtonClick"/>
                    <ribbon:RibbonButton Label="مجموعات المواد" Click="OnRibbonButtonClick"/>
                </ribbon:RibbonGroup>
                <ribbon:RibbonGroup Header="الباركود">
                    <ribbon:RibbonButton Label="توليد الباركود" Click="OnRibbonButtonClick"/>
                    <ribbon:RibbonButton Label="تصميم وطباعة الباركود" Click="OnRibbonButtonClick"/>
                    <ribbon:RibbonButton Label="إنشاء باركود" Click="OnRibbonButtonClick"/>
                </ribbon:RibbonGroup>
                <ribbon:RibbonGroup Header="الحركات">
                    <ribbon:RibbonButton Label="قائمة الأسعار" Click="OnRibbonButtonClick"/>
                    <ribbon:RibbonButton Label="بضاعة آخر المدة" Click="OnRibbonButtonClick"/>
                    <ribbon:RibbonButton Label="لائحة النواقص" Click="OnRibbonButtonClick"/>
                    <ribbon:RibbonButton Label="نقل حركة مادة" Click="OnRibbonButtonClick"/>
                    <ribbon:RibbonButton Label="تسوية جردية" Click="OnRibbonButtonClick"/>
                </ribbon:RibbonGroup>
                <ribbon:RibbonGroup Header="تقارير المواد">
                    <ribbon:RibbonButton Label="شجرة المواد" Click="OnRibbonButtonClick"/>
                    <ribbon:RibbonButton Label="بحث المواد" Click="OnRibbonButtonClick"/>
                    <ribbon:RibbonButton Label="جرد المستودعات" Click="OnRibbonButtonClick"/>
                    <ribbon:RibbonButton Label="حركة مادة" Click="OnRibbonButtonClick"/>
                    <ribbon:RibbonButton Label="مخطط حركة مادة" Click="OnRibbonButtonClick"/>
                    <ribbon:RibbonButton Label="المواد المنتهية الصلاحية" Click="OnRibbonButtonClick"/>
                    <ribbon:RibbonButton Label="أعمار الفواتير" Click="OnRibbonButtonClick"/>
                    <ribbon:RibbonButton Label="أرباح المواد" Click="OnRibbonButtonClick"/>
                    <ribbon:RibbonButton Label="تاريخ أسعار المواد" Click="OnRibbonButtonClick"/>
                    <ribbon:RibbonButton Label="تقارير المواد الخدمية" Click="OnRibbonButtonClick"/>
                    <ribbon:RibbonButton Label="إحصائيات المواد" Click="OnRibbonButtonClick"/>
                    <ribbon:RibbonButton Label="المواد الراكدة" Click="OnRibbonButtonClick"/>
                    <ribbon:RibbonButton Label="المواد الأكثر حركة" Click="OnRibbonButtonClick"/>
                    <ribbon:RibbonButton Label="مقارنة مادة" Click="OnRibbonButtonClick"/>
                    <ribbon:RibbonButton Label="لائحة المواد" Click="OnRibbonButtonClick"/>
                    <ribbon:RibbonButton Label="تقرير حركة المواد والمجموعات" Click="OnRibbonButtonClick"/>
                    <ribbon:RibbonButton Label="الإخراج بالسالب" Click="OnRibbonButtonClick"/>
                </ribbon:RibbonGroup>
                <ribbon:RibbonGroup Header="أخرى">
                    <ribbon:RibbonButton Label="تقاطع المواد مع العملاء" Click="OnRibbonButtonClick"/>
                    <ribbon:RibbonButton Label="تقرير الأرقام التسلسلية" Click="OnRibbonButtonClick"/>
                    <ribbon:RibbonButton Label="تعديل رقم تسلسلي" Click="OnRibbonButtonClick"/>
                    <ribbon:RibbonButton Label="مواد الفروع" Click="OnRibbonButtonClick"/>
                    <ribbon:RibbonButton Label="تقرير المبيعات" Click="OnRibbonButtonClick"/>
                    <ribbon:RibbonButton Label="تعديل مواصفات المواد" Click="OnRibbonButtonClick"/>
                    <ribbon:RibbonButton Label="حسومات المواد" Click="OnRibbonButtonClick"/>
                </ribbon:RibbonGroup>
            </ribbon:RibbonTab>

            <!-- ============================================================
                 تبويب: حسابات
                 ============================================================ -->
            <ribbon:RibbonTab x:Name="TabAccounts" Header="حسابات" Visibility="Collapsed">
                <ribbon:RibbonGroup Header="عام">
                    <ribbon:RibbonButton Label="شجرة الحسابات" Click="OnRibbonButtonClick"/>
                    <ribbon:RibbonButton Label="مركز كلفة" Click="OnRibbonButtonClick"/>
                    <ribbon:RibbonButton Label="بطاقة مركز كلفة" Click="OnRibbonButtonClick"/>
                    <ribbon:RibbonButton Label="ربط مع الحسابات" Click="OnRibbonButtonClick"/>
                    <ribbon:RibbonButton Label="تقرير مركز كلفة" Click="OnRibbonButtonClick"/>
                    <ribbon:RibbonButton Label="حركة مواد مركز كلفة" Click="OnRibbonButtonClick"/>
                    <ribbon:RibbonButton Label="ميزان مركز كلفة" Click="OnRibbonButtonClick"/>
                </ribbon:RibbonGroup>
                <ribbon:RibbonGroup Header="العملات">
                    <ribbon:RibbonButton Label="تعريف عملة" Click="OnRibbonButtonClick"/>
                    <ribbon:RibbonButton Label="نشرة أسعار العملات" Click="OnRibbonButtonClick"/>
                    <ribbon:RibbonButton Label="متوسط سعر العملات" Click="OnRibbonButtonClick"/>
                    <ribbon:RibbonButton Label="فروق أسعار الصرف" Click="OnRibbonButtonClick"/>
                </ribbon:RibbonGroup>
                <ribbon:RibbonGroup Header="التقارير">
                    <ribbon:RibbonButton Label="دفتر الأستاذ" Click="OnRibbonButtonClick"/>
                    <ribbon:RibbonButton Label="كشف حساب عميل" Click="OnRibbonButtonClick"/>
                    <ribbon:RibbonButton Label="دفتر اليومية العامة" Click="OnRibbonButtonClick"/>
                    <ribbon:RibbonButton Label="التقرير اليومي" Click="OnRibbonButtonClick"/>
                    <ribbon:RibbonButton Label="مخطط حركة حساب" Click="OnRibbonButtonClick"/>
                    <ribbon:RibbonButton Label="رصيد حساب" Click="OnRibbonButtonClick"/>
                    <ribbon:RibbonButton Label="حركة حساب الفروع" Click="OnRibbonButtonClick"/>
                    <ribbon:RibbonButton Label="ميزان المراجعة" Click="OnRibbonButtonClick"/>
                </ribbon:RibbonGroup>
                <ribbon:RibbonGroup Header="الحسابات الختامية">
                    <ribbon:RibbonButton Label="التشغيل" Click="OnRibbonButtonClick"/>
                    <ribbon:RibbonButton Label="المتاجرة" Click="OnRibbonButtonClick"/>
                    <ribbon:RibbonButton Label="أرباح خسائر" Click="OnRibbonButtonClick"/>
                </ribbon:RibbonGroup>
                <ribbon:RibbonGroup Header="القوائم المالية">
                    <ribbon:RibbonButton Label="الميزانية" Click="OnRibbonButtonClick"/>
                    <ribbon:RibbonButton Label="قائمة الدخل" Click="OnRibbonButtonClick"/>
                    <ribbon:RibbonButton Label="قائمة التدفق النقدي" Click="OnRibbonButtonClick"/>
                </ribbon:RibbonGroup>
                <ribbon:RibbonGroup Header="تحليل">
                    <ribbon:RibbonButton Label="الحسابات الراكدة" Click="OnRibbonButtonClick"/>
                    <ribbon:RibbonButton Label="أعمار الذمم" Click="OnRibbonButtonClick"/>
                    <ribbon:RibbonButton Label="نسب التحصيل" Click="OnRibbonButtonClick"/>
                    <ribbon:RibbonButton Label="مقارنة حساب" Click="OnRibbonButtonClick"/>
                    <ribbon:RibbonButton Label="تحليل مالي محلي" Click="OnRibbonButtonClick"/>
                    <ribbon:RibbonButton Label="تحليل مالي AI" Click="OnRibbonButtonClick"/>
                </ribbon:RibbonGroup>
            </ribbon:RibbonTab>

            <!-- ============================================================
                 تبويب: سندات
                 ============================================================ -->
            <ribbon:RibbonTab x:Name="TabBonds" Header="سندات" Visibility="Collapsed">
                <ribbon:RibbonGroup Header="السندات">
                    <ribbon:RibbonButton Label="سند قيد" Click="OnRibbonButtonClick"/>
                    <ribbon:RibbonButton Label="سند قبض" Click="OnRibbonButtonClick"/>
                    <ribbon:RibbonButton Label="سند دفع" Click="OnRibbonButtonClick"/>
                    <ribbon:RibbonButton Label="سند يومية" Click="OnRibbonButtonClick"/>
                    <ribbon:RibbonButton Label="يومية الصندوق" Click="OnRibbonButtonClick"/>
                    <ribbon:RibbonButton Label="تعريف أنماط السندات" Click="OnRibbonButtonClick"/>
                </ribbon:RibbonGroup>
                <ribbon:RibbonGroup Header="التقسيط">
                    <ribbon:RibbonButton Label="تقسيط المبالغ" Click="OnRibbonButtonClick"/>
                    <ribbon:RibbonButton Label="بحث تقسيط المبالغ" Click="OnRibbonButtonClick"/>
                </ribbon:RibbonGroup>
                <ribbon:RibbonGroup Header="الأوراق المالية">
                    <ribbon:RibbonButton Label="شيك قبض" Click="OnRibbonButtonClick"/>
                    <ribbon:RibbonButton Label="شيك دفع" Click="OnRibbonButtonClick"/>
                    <ribbon:RibbonButton Label="تعريف الأوراق المالية" Click="OnRibbonButtonClick"/>
                    <ribbon:RibbonButton Label="بحث الأوراق المالية" Click="OnRibbonButtonClick"/>
                </ribbon:RibbonGroup>
                <ribbon:RibbonGroup Header="الدفعات">
                    <ribbon:RibbonButton Label="أنماط الدفعات" Click="OnRibbonButtonClick"/>
                    <ribbon:RibbonButton Label="تعريف أنماط الدفعات" Click="OnRibbonButtonClick"/>
                </ribbon:RibbonGroup>
                <ribbon:RibbonGroup Header="مراقبة">
                    <ribbon:RibbonButton Label="مراقبة وتعديل السندات" Click="OnRibbonButtonClick"/>
                </ribbon:RibbonGroup>
            </ribbon:RibbonTab>

            <!-- ============================================================
                 تبويب: فواتير
                 ============================================================ -->
            <ribbon:RibbonTab x:Name="TabInvoices" Header="فواتير" Visibility="Collapsed">
                <ribbon:RibbonGroup Header="الفواتير">
                    <ribbon:RibbonButton Label="مناقلة" Click="OnRibbonButtonClick"/>
                    <ribbon:RibbonButton Label="فاتورة بضاعة أول المدة" Click="OnRibbonButtonClick"/>
                    <ribbon:RibbonButton Label="فاتورة إدخال مواد" Click="OnRibbonButtonClick"/>
                    <ribbon:RibbonButton Label="فاتورة إخراج مواد" Click="OnRibbonButtonClick"/>
                </ribbon:RibbonGroup>
                <ribbon:RibbonGroup Header="المشتريات">
                    <ribbon:RibbonButton Label="فاتورة مشتريات" Click="OnRibbonButtonClick"/>
                    <ribbon:RibbonButton Label="فاتورة مردودات مشتريات" Click="OnRibbonButtonClick"/>
                </ribbon:RibbonGroup>
                <ribbon:RibbonGroup Header="المبيعات">
                    <ribbon:RibbonButton Label="فاتورة مبيعات" Click="OnRibbonButtonClick"/>
                    <ribbon:RibbonButton Label="فاتورة مردودات مبيعات" Click="OnRibbonButtonClick"/>
                    <ribbon:RibbonButton Label="فاتورة محضر جرد" Click="OnRibbonButtonClick"/>
                    <ribbon:RibbonButton Label="طباعة الباركود" Click="OnRibbonButtonClick"/>
                </ribbon:RibbonGroup>
                <ribbon:RibbonGroup Header="عام">
                    <ribbon:RibbonButton Label="تعريف الفواتير" Click="OnRibbonButtonClick"/>
                    <ribbon:RibbonButton Label="بحث الفواتير" Click="OnRibbonButtonClick"/>
                    <ribbon:RibbonButton Label="فواتير المبيعات النقدية" Click="OnRibbonButtonClick"/>
                    <ribbon:RibbonButton Label="إغلاق الصندوق" Click="OnRibbonButtonClick"/>
                    <ribbon:RibbonButton Label="عرض سعر" Click="OnRibbonButtonClick"/>
                    <ribbon:RibbonButton Label="بحث عروض السعر" Click="OnRibbonButtonClick"/>
                    <ribbon:RibbonButton Label="أرباح الفواتير" Click="OnRibbonButtonClick"/>
                    <ribbon:RibbonButton Label="لائحة التعبئة" Click="OnRibbonButtonClick"/>
                </ribbon:RibbonGroup>
                <ribbon:RibbonGroup Header="أدوات أخرى">
                    <ribbon:RibbonButton Label="ضغط الفواتير" Click="OnRibbonButtonClick"/>
                    <ribbon:RibbonButton Label="إعادة ترحيل الفواتير" Click="OnRibbonButtonClick"/>
                </ribbon:RibbonGroup>
            </ribbon:RibbonTab>

            <!-- ============================================================
                 تبويب: نقاط البيع
                 ============================================================ -->
            <ribbon:RibbonTab x:Name="TabPOS" Header="نقاط بيع" Visibility="Collapsed">
                <ribbon:RibbonGroup Header="الإدارة">
                    <ribbon:RibbonButton Label="النقاط" Click="OnRibbonButtonClick"/>
                    <ribbon:RibbonButton Label="تعريف نقاط البيع" Click="OnRibbonButtonClick"/>
                    <ribbon:RibbonButton Label="تقرير صندوق نقطة بيع" Click="OnRibbonButtonClick"/>
                    <ribbon:RibbonButton Label="حسومات نقطة بيع" Click="OnRibbonButtonClick"/>
                    <ribbon:RibbonButton Label="مزامنة نقاط البيع" Click="OnRibbonButtonClick"/>
                </ribbon:RibbonGroup>
                <ribbon:RibbonGroup Header="تقارير">
                    <ribbon:RibbonButton Label="تعديل سعر مادة" Click="OnRibbonButtonClick"/>
                    <ribbon:RibbonButton Label="تعديل كمية مادة" Click="OnRibbonButtonClick"/>
                    <ribbon:RibbonButton Label="حذف مادة" Click="OnRibbonButtonClick"/>
                </ribbon:RibbonGroup>
            </ribbon:RibbonTab>

            <!-- ============================================================
                 تبويب: طلبيات
                 ============================================================ -->
            <ribbon:RibbonTab x:Name="TabOrders" Header="طلبيات" Visibility="Collapsed">
                <ribbon:RibbonGroup Header="الطلبيات">
                    <ribbon:RibbonButton Label="طلبية شراء" Click="OnRibbonButtonClick"/>
                    <ribbon:RibbonButton Label="طلبية بيع" Click="OnRibbonButtonClick"/>
                </ribbon:RibbonGroup>
                <ribbon:RibbonGroup Header="عام">
                    <ribbon:RibbonButton Label="تعريف الطلبيات" Click="OnRibbonButtonClick"/>
                    <ribbon:RibbonButton Label="فواتير استلام وتسليم الطلبيات" Click="OnRibbonButtonClick"/>

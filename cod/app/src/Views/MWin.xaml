        <!-- منطقة المحتوى -->
        <Border Grid.Row="4"
                Background="{DynamicResource ShellContentBackgroundBrush}"
                BorderBrush="{DynamicResource ShellContentBorderBrush}"
                BorderThickness="0"
                CornerRadius="0"
                Margin="0">
            <ContentControl Content="{Binding CurrentContent}"/>
        </Border>

        <!-- منطقة النوافذ المصغرة داخل ShouTech -->
        <Border x:Name="InternalWindowDock"
                Grid.Row="5"
                Margin="8,2,8,4"
                Height="58"
                Background="{DynamicResource ShellStatusBarBackgroundBrush}"
                BorderBrush="{DynamicResource ShellContentBorderBrush}"
                BorderThickness="1"
                CornerRadius="5"
                Visibility="Collapsed"
                ClipToBounds="True">
            <ItemsControl ItemsSource="{Binding DockedWindows}"
                          HorizontalAlignment="Stretch"
                          VerticalAlignment="Stretch">
                <ItemsControl.ItemsPanel>
                    <ItemsPanelTemplate>
                        <Canvas ClipToBounds="True"/>
                    </ItemsPanelTemplate>
                </ItemsControl.ItemsPanel>
                <ItemsControl.ItemContainerStyle>
                    <Style TargetType="ContentPresenter">
                        <Setter Property="Canvas.Left" Value="{Binding Left}"/>
                        <Setter Property="Canvas.Top" Value="4"/>
                        <Setter Property="Panel.ZIndex" Value="{Binding ZIndex}"/>
                    </Style>
                </ItemsControl.ItemContainerStyle>
                <ItemsControl.ItemTemplate>
                    <DataTemplate>
                        <Button Command="{Binding DataContext.RestoreDockedWindowCommand, RelativeSource={RelativeSource AncestorType=ItemsControl}}"
                                CommandParameter="{Binding}"
                                Width="{Binding ItemWidth}"
                                Height="48"
                                Padding="10,4"
                                HorizontalContentAlignment="Stretch"
                                VerticalContentAlignment="Center"
                                Background="{DynamicResource ShellBackgroundBrush}"
                                Foreground="{DynamicResource TextBrush}"
                                BorderBrush="{DynamicResource ShellContentBorderBrush}"
                                BorderThickness="1"
                                ToolTip="استعادة النافذة">
                            <TextBlock Text="{Binding Title}"
                                       TextTrimming="CharacterEllipsis"
                                       FontWeight="SemiBold"
                                       TextAlignment="Center"
                                       VerticalAlignment="Center"/>
                        </Button>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>
        </Border>

        <!-- معلومات الشركة: شريط صغير ثابت أسفل الـDock -->
        <StatusBar x:Name="MainStatusBar" Grid.Row="6"
                   Background="{DynamicResource ShellStatusBarBackgroundBrush}"
                   Foreground="{DynamicResource ShellStatusBarForegroundBrush}"
                   Height="26">
            <StatusBarItem>
                <StackPanel Orientation="Horizontal">
                    <TextBlock Text="الشركة: " Opacity="0.78" Margin="0,0,3,0"/>
                    <TextBlock Text="{Binding CompanyName}" FontWeight="SemiBold"/>
                </StackPanel>
            </StatusBarItem>
            <StatusBarItem>
                <StackPanel Orientation="Horizontal">
                    <TextBlock Text="المستخدم: " Opacity="0.78" Margin="0,0,3,0"/>
                    <TextBlock Text="{Binding CurrentUser}" FontWeight="SemiBold"/>
                </StackPanel>
            </StatusBarItem>
            <StatusBarItem>
                <StackPanel Orientation="Horizontal">
                    <TextBlock Text="قاعدة البيانات: " Opacity="0.78" Margin="0,0,3,0"/>
                    <TextBlock Text="{Binding CurrentDatabase}" FontWeight="SemiBold"/>
                </StackPanel>
            </StatusBarItem>
        </StatusBar>
    </Grid>
</ribbon:RibbonWindow>
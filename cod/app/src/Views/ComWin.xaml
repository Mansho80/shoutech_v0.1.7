<Window x:Class="ShouTech.App.Views.ComWin"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:loc="clr-namespace:ShouTech.App.Localization"
        Title="Select Company"
        loc:LocProps.WindowKey="CompanySelection.WindowTitle"
        Height="500" Width="700"
        WindowStartupLocation="CenterScreen"
        ResizeMode="CanResize"
        MinHeight="440" MinWidth="620"
        WindowStyle="None"
        AllowsTransparency="False"
        Background="{DynamicResource BackgroundBrush}"
        Foreground="{DynamicResource TextBrush}"
        FontFamily="Segoe UI, Tahoma">
    <Grid Background="{DynamicResource BackgroundBrush}">
        <Border Margin="28,22,28,24"
                Background="{DynamicResource BackgroundBrush}"
                BorderBrush="{DynamicResource BorderBrush}"
                BorderThickness="0,0,0,1"
                Padding="0,0,0,14">
        <DockPanel x:Name="rootDock" LastChildFill="True">

            <!-- Management side panel -->
            <Border x:Name="mgmtPanel"
                    DockPanel.Dock="Right"
                    Visibility="Collapsed"
                    Background="{DynamicResource SurfaceBrush}"
                    BorderBrush="{DynamicResource BorderBrush}"
                    BorderThickness="1"
                    CornerRadius="4"
                    Padding="10"
                    Width="150"
                    VerticalAlignment="Stretch">
                <DockPanel LastChildFill="False">
                    <TextBlock x:Name="txtMgmtTitle"
                               DockPanel.Dock="Top"
                               Text="إدارة الشركات"
                               FontWeight="SemiBold"
                               FontSize="13"
                               TextAlignment="Center"
                               Margin="0,0,0,12"/>
                    <StackPanel DockPanel.Dock="Top">
                        <Button x:Name="btnMgmtOpen" Content="فتح"
                                Height="34" Margin="0,0,0,8" Padding="8,4"
                                HorizontalAlignment="Stretch"
                                Click="BtnMgmtOpen_Click"
                                Style="{DynamicResource PrimaryButtonStyle}"/>
                        <Button x:Name="btnMgmtEdit" Content="تعديل"
                                Height="34" Margin="0,0,0,8" Padding="8,4"
                                HorizontalAlignment="Stretch"
                                Click="BtnMgmtEdit_Click"
                                Style="{DynamicResource SecondaryButtonStyle}"/>

                        <Button x:Name="btnMgmtDelete"
                                Height="34" Margin="0,0,0,8" Padding="8,4"
                                HorizontalAlignment="Stretch"
                                Click="BtnMgmtDeleteMenu_Click"
                                Style="{DynamicResource SecondaryButtonStyle}"
                                ToolTip="خيارات الحذف">
                            <Button.Content>
                                <Grid Width="120">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="18"/>
                                    </Grid.ColumnDefinitions>
                                    <TextBlock x:Name="txtDeleteLabel"
                                               Grid.Column="0"
                                               Text="حذف"
                                               HorizontalAlignment="Center"
                                               VerticalAlignment="Center"/>
                                    <TextBlock Grid.Column="1"
                                               Text="▾"
                                               FontSize="11"
                                               Opacity="0.85"
                                               HorizontalAlignment="Center"
                                               VerticalAlignment="Center"/>
                                </Grid>
                            </Button.Content>
                            <Button.ContextMenu>
                                <ContextMenu x:Name="deleteContextMenu" Placement="Bottom">
                                    <MenuItem x:Name="miDeleteFromIndex"
                                              Header="حذف من النافذة"
                                              Click="BtnDeleteFromIndex_Click"/>
                                    <Separator/>
                                    <MenuItem x:Name="miDeleteFully"
                                              Header="حذف كامل"
                                              Click="BtnDeleteFully_Click"/>
                                </ContextMenu>
                            </Button.ContextMenu>
                        </Button>

                        <Button x:Name="btnMgmtReindex" Content="فهرسة"
                                Height="34" Margin="0,0,0,8" Padding="8,4"
                                HorizontalAlignment="Stretch"
                                Click="BtnMgmtReindex_Click"
                                Style="{DynamicResource SecondaryButtonStyle}"/>
                        <Button x:Name="btnMgmtDefault" Content="افتراضي"
                                Height="34" Margin="0,0,0,8" Padding="8,4"
                                HorizontalAlignment="Stretch"
                                Click="BtnMgmtDefault_Click"
                                Style="{DynamicResource SecondaryButtonStyle}"/>
                    </StackPanel>
                    <Button x:Name="btnMgmtClose" Content="إغلاق"
                            DockPanel.Dock="Bottom"
                            Height="34" Margin="0,16,0,0" Padding="8,4"
                            HorizontalAlignment="Stretch"
                            VerticalAlignment="Bottom"
                            Click="BtnMgmtClose_Click"
                            Style="{DynamicResource SecondaryButtonStyle}"/>
                </DockPanel>
            </Border>

            <!-- List / Edit area -->
            <Grid x:Name="contentGrid">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>

                <Grid Grid.Row="0" Margin="0,0,0,14">
                    <StackPanel>
                        <TextBlock x:Name="txtTitle"
                                   Text="اختيار الشركة"
                                   loc:LocProps.Key="CompanySelection.Title"
                                   FontSize="22"
                                   FontWeight="SemiBold"
                                   Foreground="{DynamicResource TextBrush}"/>
                        <TextBlock x:Name="txtHint"
                                   Text="اختر الشركة للمتابعة إلى تسجيل الدخول"
                                   loc:LocProps.Key="CompanySelection.Hint"
                                   FontSize="12"
                                   Foreground="{DynamicResource TextSecondaryBrush}"
                                   Margin="0,5,0,0"/>
                    </StackPanel>
                </Grid>

                <!-- LIST -->
                <Border x:Name="listPanel"
                        Grid.Row="1"
                        Background="{DynamicResource SurfaceBrush}"
                        BorderBrush="{DynamicResource BorderBrush}"
                        BorderThickness="1"
                        CornerRadius="6"
                        Padding="8">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="*"/>
                        </Grid.RowDefinitions>
                        <Grid Grid.Row="0" Margin="4,2,4,8">
                            <TextBox x:Name="txtSearch"
                                     Height="34"
                                     Padding="10,5"
                                     VerticalContentAlignment="Center"
                                     Background="{DynamicResource SurfaceDarkBrush}"
                                     Foreground="{DynamicResource TextBrush}"
                                     BorderBrush="{DynamicResource BorderBrush}"
                                     BorderThickness="1"
                                     TextChanged="TxtSearch_TextChanged"
                                     ToolTip="Search companies"/>
                        </Grid>
                        <ListBox x:Name="lstCompanies"
                                 Grid.Row="1"
                                 Margin="4"
                                 ItemsSource="{Binding FilteredCompanies}"
                                 SelectedItem="{Binding SelectedCompany, Mode=TwoWay}"
                                 MouseDoubleClick="LstCompanies_MouseDoubleClick"
                                 BorderThickness="0"
                                 Background="Transparent"
                                 ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                                 ScrollViewer.VerticalScrollBarVisibility="Auto">
                            <ListBox.ItemTemplate>
                                <DataTemplate>
                                    <Border Background="{DynamicResource SurfaceBrush}"
                                            BorderBrush="{DynamicResource BorderBrush}"
                                            BorderThickness="0,0,0,1"
                                            Padding="10,9">
                                        <TextBlock Text="{Binding DisplayName}"
                                                   FontSize="14"
                                                   Foreground="{DynamicResource TextBrush}"/>
                                    </Border>
                                </DataTemplate>
                            </ListBox.ItemTemplate>
                        </ListBox>
                    </Grid>
                </Border>

                <!-- EDIT (same region) -->
                <Border x:Name="editPanel"
                        Grid.Row="1"
                        Visibility="Collapsed"
                        Background="{DynamicResource SurfaceBrush}"
                        BorderBrush="{DynamicResource BorderBrush}"
                        BorderThickness="1"
                        CornerRadius="4"
                        Padding="12">
                    <ScrollViewer VerticalScrollBarVisibility="Auto">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="140"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                            </Grid.RowDefinitions>

                            <TextBlock x:Name="lblEditNameAr" Grid.Row="0" Grid.Column="0" Text="الاسم (عربي)" VerticalAlignment="Center" Margin="0,0,8,8"/>
                            <TextBox x:Name="txtEditNameAr" Grid.Row="0" Grid.Column="1" Height="30" Margin="0,0,0,8"/>

                            <TextBlock x:Name="lblEditNameEn" Grid.Row="1" Grid.Column="0" Text="الاسم (إنجليزي)" VerticalAlignment="Center" Margin="0,0,8,8"/>
                            <TextBox x:Name="txtEditNameEn" Grid.Row="1" Grid.Column="1" Height="30" Margin="0,0,0,8"/>

                            <TextBlock x:Name="lblEditTax" Grid.Row="2" Grid.Column="0" Text="الرقم الضريبي / السجل" VerticalAlignment="Center" Margin="0,0,8,8"/>
                            <TextBox x:Name="txtEditTax" Grid.Row="2" Grid.Column="1" Height="30" Margin="0,0,0,8"/>

                            <TextBlock x:Name="lblEditEmail" Grid.Row="3" Grid.Column="0" Text="البريد" VerticalAlignment="Center" Margin="0,0,8,8"/>
                            <TextBox x:Name="txtEditEmail" Grid.Row="3" Grid.Column="1" Height="30" Margin="0,0,0,8"/>

                            <TextBlock x:Name="lblEditPhone" Grid.Row="4" Grid.Column="0" Text="الهاتف" VerticalAlignment="Center" Margin="0,0,8,8"/>
                            <TextBox x:Name="txtEditPhone" Grid.Row="4" Grid.Column="1" Height="30" Margin="0,0,0,8"/>

                            <TextBlock x:Name="lblEditMobile" Grid.Row="5" Grid.Column="0" Text="الجوال" VerticalAlignment="Center" Margin="0,0,8,8"/>
                            <TextBox x:Name="txtEditMobile" Grid.Row="5" Grid.Column="1" Height="30" Margin="0,0,0,8"/>

                            <TextBlock x:Name="lblEditAddress" Grid.Row="6" Grid.Column="0" Text="العنوان" VerticalAlignment="Center" Margin="0,0,8,8"/>
                            <TextBox x:Name="txtEditAddress" Grid.Row="6" Grid.Column="1" Height="30" Margin="0,0,0,8"/>

                            <TextBlock x:Name="lblEditCity" Grid.Row="7" Grid.Column="0" Text="المدينة" VerticalAlignment="Center" Margin="0,0,8,8"/>
                            <TextBox x:Name="txtEditCity" Grid.Row="7" Grid.Column="1" Height="30" Margin="0,0,0,8"/>

                            <TextBlock x:Name="lblEditCountry" Grid.Row="8" Grid.Column="0" Text="الدولة" VerticalAlignment="Center" Margin="0,0,8,8"/>
                            <TextBox x:Name="txtEditCountry" Grid.Row="8" Grid.Column="1" Height="30" Margin="0,0,0,8"/>

                            <TextBlock x:Name="lblEditCurrency" Grid.Row="9" Grid.Column="0" Text="العملة" VerticalAlignment="Center" Margin="0,0,8,8"/>
                            <TextBox x:Name="txtEditCurrency" Grid.Row="9" Grid.Column="1" Height="30" Margin="0,0,0,8"/>

                            <StackPanel Grid.Row="10" Grid.Column="0" Grid.ColumnSpan="2"
                                        Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,12,0,0">
                                <Button x:Name="btnEditSave" Content="حفظ" Width="100" Height="32" Margin="0,0,8,0"
                                        Click="BtnEditSave_Click" Style="{DynamicResource PrimaryButtonStyle}"/>
                                <Button x:Name="btnEditCancel" Content="إلغاء" Width="100" Height="32"
                                        Click="BtnEditCancel_Click" Style="{DynamicResource SecondaryButtonStyle}"/>
                            </StackPanel>
                        </Grid>
                    </ScrollViewer>
                </Border>

                <!-- Startup OK / Cancel -->
                <Grid x:Name="btnBar"
                      Grid.Row="2"
                      Margin="0,14,0,0"
                      HorizontalAlignment="Right"
                      Width="220">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="100"/>
                        <ColumnDefinition Width="12"/>
                        <ColumnDefinition Width="100"/>
                    </Grid.ColumnDefinitions>
                    <Button x:Name="btnOk"
                            Grid.Column="0"
                            Content="OK"
                            loc:LocProps.Key="CompanySelection.Ok"
                            Height="32"
                            FontWeight="SemiBold"
                            Click="BtnContinue_Click"
                            IsDefault="True"
                            Style="{DynamicResource PrimaryButtonStyle}"/>
                    <Button x:Name="btnCancel"
                            Grid.Column="2"
                            Content="Cancel"
                            loc:LocProps.Key="Buttons.Cancel"
                            Height="32"
                            Click="BtnCancel_Click"
                            IsCancel="True"
                            Style="{DynamicResource SecondaryButtonStyle}"/>
                </Grid>
            </Grid>
        </DockPanel>
        </Border>
    </Grid>
</Window>
